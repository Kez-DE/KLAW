# Klaw frontend — biến môi trường. Chép thành `.env` và điền giá trị thật.
# KHÔNG commit `.env`.
#
# CẢNH BÁO: mọi biến có tiền tố `VITE_` được inject vào BUNDLE CLIENT lúc build
# (`loadEnv(mode, cwd, "VITE_")`). Chỉ đặt tiền tố này cho giá trị công khai.
# Khoá backend, service_role, API key của nhà cung cấp: KHÔNG BAO GIỜ dùng `VITE_`.

# --- Supabase (chỉ dùng khoá publishable — công khai theo thiết kế) ---
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# --- Gốc tuyệt đối của site, dùng cho canonical + JSON-LD ---
# Không đặt thì mặc định http://localhost:3000. Đặt thành tên miền thật khi deploy.
VITE_SITE_ORIGIN=
