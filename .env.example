# ══ OpenRouter — một key, ba endpoint ══
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# LLM — ba vai, ba model (mục 7b.1)
OPENROUTER_MODEL_NAME=mistralai/mistral-nemo                          # route + rewrite_query
OPENROUTER_GENERATE_MODEL_NAME=google/gemini-2.5-flash-lite            # generate_claims — BẮT BUỘC structured output
OPENROUTER_JUDGE_MODEL_NAME=mistralai/mistral-small-3.2-24b-instruct   # verify_tier2 — PHẢI khác họ với GENERATE (7b.2)

# Embedding — cùng key, endpoint /embeddings
OPENROUTER_EMBEDDING_MODEL_NAME=baai/bge-m3
OPENROUTER_EMBEDDING_DIM=1024

# Rerank — tùy chọn, mặc định TẮT
OPENROUTER_RERANK_MODEL_NAME=cohere/rerank-4-fast
OPENROUTER_RERANK_ENABLED=false

# ⚠ Temperature: 0.0, KHÔNG phải 0.7 của template
LLM_TEMPERATURE=0.0

# ══ Database ══
# Local (docker-compose, mục 4b.4). Trên Railway dùng variable reference, không hardcode
DATABASE_URL=postgresql://klaw:klaw@localhost:5432/klaw

# ══ Retrieval & chunking — trước đây hardcode trong spec, giờ là biến ══
CHUNK_MAX_TOKENS=1500              # Điều dài hơn thì cắt theo Khoản (4.5)
RETRIEVE_BM25_TOPK=20
RETRIEVE_DENSE_TOPK=20
RRF_K=60                           # giá trị thường dùng — CẦN XÁC MINH nguồn trước khi trích trong khóa luận
RETRIEVE_FINAL_TOPK=10
EXPAND_REFERENCE_HOPS=1            # 1 hop, không lặp sâu (4.6)

# ══ Verifier ══
VERIFY_TIER2_ENABLED=true          # tắt = cấu hình ablation "chỉ tầng 1"
ABSTAIN_THRESHOLD=0.5              # tỉ lệ claim verified tối thiểu (6.3)
AS_OF_DATE=                        # rỗng = hôm nay; đặt giá trị để tra cứu theo mốc thời gian

# ══ Eval ══
EVAL_CONFIG_NAME=full              # tên cấu hình, ghi vào traces.config_name
EVAL_DATASET_DIR=./eval/datasets
EVAL_RESULT_DIR=./eval/results

# ══ Data & ingest ══
DATA_RAW_DIR=./data/raw            # parquet tải về — GITIGNORE
DATA_SEED_DIR=./data/seed          # seed đã parse — VÀO GIT
MOJ_API_BASE=https://vbpl-bientap-gateway.moj.gov.vn/api/qtdc/public
MOJ_RATE_LIMIT_SLEEP=1.5           # giây giữa các request (thấy HTTP 400 sau ~35 request liên tiếp)

# ══ Cổng bảo vệ (Plan 4) — XEM LẠI TRƯỚC KHI DEPLOY CÔNG KHAI ══
#
# Số đo trên DB thật, dùng để chọn mặc định dưới đây (không phải ước lượng):
#   /tra-cuu gọi LLM tối đa 5 lần; p50 10.000ms, p95 50.289ms (204 dòng traces)
#   request đắt nhất đã ghi nhận: $0,00735
#   ngày cao nhất tới nay: 118 request / $0,18329 (2026-08-30)
# Dự án ĐÃ gặp HTTP 429 từ OpenRouter khi nhiều tiến trình chạy song song.

# RỖNG = MỞ (chỉ hợp cho dev local). Có giá trị = BẮT BUỘC header
# `X-API-Key: <giá trị>` trên /tra-cuu và /soan-thao (hai endpoint tốn LLM).
# /pham-vi, /van-ban, /mau, /soat, /health KHÔNG cần key.
# TRƯỚC KHI DEPLOY: đặt một giá trị ngẫu nhiên dài (`openssl rand -hex 32`).
KLAW_API_KEY=

# Trần tổng chi phí OpenRouter mỗi ngày (mốc UTC), cộng từ traces.cost_usd.
# Vượt → HTTP 429 nói rõ lý do + mốc mở lại. 0 = TẮT (cần cho eval sweep chạy
# hàng trăm request qua HTTP) — phải đặt TAY, mặc định KHÔNG vô hạn.
# $2,00 ≈ 10× ngày cao nhất đã đo ≈ 272 request ở mức đắt nhất.
KLAW_TRAN_CHI_PHI_NGAY_USD=2.0

# Rate limit theo IP, cửa sổ TRƯỢT, bộ đếm trong Postgres (không in-process:
# in-process chỉ đúng khi có MỘT worker). 0 lượt = TẮT.
# 10/60s: p50 10s nên một người dùng thật không vượt ~6 lượt/phút.
KLAW_RATE_LIMIT_SO_LUOT=10
KLAW_RATE_LIMIT_CUA_SO_GIAY=60

# true CHỈ KHI thật sự có reverse proxy đặt X-Forwarded-For. Bật mà không có
# proxy = ai cũng giả được IP và rate limit theo IP thành trang trí.
# Kèm theo: tiến trình PHẢI chạy `uvicorn --no-proxy-headers` (Dockerfile đã
# đặt) — nếu không uvicorn tự thay scope["client"] bằng header này trước khi
# `bao_ve.ip_goi` chạy, và cờ dưới đây không còn quyết định gì.
KLAW_TIN_PROXY_HEADER=false

# Số proxy TIN CẬY đứng trước ứng dụng. Proxy nối thêm vào CUỐI X-Forwarded-For
# nên client thật ở vị trí thứ N từ PHẢI; phần tử đầu là phần kẻ gọi tự viết.
KLAW_SO_HOP_PROXY_TIN_CAY=1

# Cache câu trả lời /tra-cuu (bảng answer_cache, KHÔNG Redis). 0 = TẮT —
# BẮT BUỘC tắt khi chạy eval đo latency/chi phí thật, nếu không bảng số liệu
# của khoá luận là số của cache. Chỉ answer/partial_coverage vào cache;
# abstain KHÔNG (một lần thiếu căn cứ do lỗi tạm sẽ bị đóng băng 7 ngày).
KLAW_CACHE_TTL_NGAY=7

# ── Auth Supabase (Plan 4b) ─────────────────────────────────────────────────
# Supabase chỉ làm AUTH (Google + Microsoft). Nó phát JWT, FastAPI xác minh,
# DỮ LIỆU Ở LẠI Postgres này — không nhân bản dữ liệu người dùng sang đâu.
#
# RỖNG = auth TẮT, hệ thống hoạt động đúng như trước (đường không-đăng-nhập mà
# `eval/run.py` đang dùng — bảng số liệu khoá luận không được cần một tài khoản).
# Có giá trị ⇒ `/tra-cuu` và `/soan-thao` BẮT BUỘC `Authorization: Bearer <JWT>`,
# và hạn mức chuyển từ theo-IP sang theo-NGƯỜI (xem config/han_muc.yaml).
#
# Lấy ở Supabase dashboard → Project Settings → Data API → Project URL.
# KHÔNG cần và KHÔNG nên đặt JWT secret / service_role key ở đây: backend xác
# minh bằng KHOÁ CÔNG KHAI lấy từ JWKS, nên nó không giữ bí mật nào tự phát
# được token. Đó là lý do chọn ES256/RS256 thay vì HS256.
KLAW_SUPABASE_URL=

# `aud` của access token Supabase cho người đã đăng nhập. Chỉ đổi nếu Supabase
# đổi giá trị này. (`anon` là token KHÁCH — cố ý không chấp nhận.)
KLAW_SUPABASE_JWT_AUD=authenticated

# TTL cache khoá công khai JWKS. 600s = đúng TTL cache edge của Supabase.
KLAW_SUPABASE_JWKS_TTL_GIAY=600

# ══ Giữ nguyên từ template ══
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=
LANGCHAIN_TRACING_V2=false
